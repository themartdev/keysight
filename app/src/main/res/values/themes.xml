<resources>
    <!-- The app UI is entirely Jetpack Compose. This theme only styles the window itself:
         no action bar, and a background that matches the Compose surface so there is no flash
         between the launch window and the first composed frame. -->
    <style name="Theme.KeySight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
